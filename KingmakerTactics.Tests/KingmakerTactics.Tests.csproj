<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(SolutionDir)GamePath.props" Condition="Exists('$(SolutionDir)GamePath.props')" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KingmakerTactics.Tests</RootNamespace>
    <AssemblyName>KingmakerTactics.Tests</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KingmakerTactics\KingmakerTactics.csproj" />
  </ItemGroup>

  <!--
    Compile-time reference to the game assembly. The CopyGameDllsToTestOutput target
    below only puts DLLs in the OUTPUT folder, which is enough for type loading at
    runtime but not for compiling against Kingmaker types. Tests that name a game type
    directly (ActionSlotsTests uses UnitCommand.CommandType) need this reference.
    Non-publicized on purpose: only the public surface is used here, and publicizing
    merely widens visibility, so the runtime overlay stays binary-compatible.
  -->
  <ItemGroup>
    <Reference Include="$(KingmakerInstallDir)\Kingmaker_Data\Managed\Assembly-CSharp.dll" Private="false" />
    <!-- UnityEngine.Color / Mathf are plain managed structs: ThemeTests exercises Theme.PackBandTint. -->
    <Reference Include="$(KingmakerInstallDir)\Kingmaker_Data\Managed\UnityEngine.CoreModule.dll" Private="false" />
    <!-- LegacyContentLoadTests deserializes through SafeConditionConverter (game's Newtonsoft). -->
    <Reference Include="$(KingmakerInstallDir)\Kingmaker_Data\Managed\Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>

  <!--
    The Mod's csproj marks Game DLLs as Private="false" (they're not copied to its
    Mod's output, since the game already provides them at runtime). The test runner
    has no game runtime, so static fields like UnitEntityData LastMatchedEnemy in
    ConditionEvaluator can't resolve their types and TypeLoadException fires.
    Copy the Game DLLs from the symlinked GameInstall/ into the test output, then
    overlay the publicized variants the Mod was built against so member signatures
    match.
  -->
  <Target Name="CopyGameDllsToTestOutput" AfterTargets="Build">
    <ItemGroup>
      <_GameDllsBase Include="$(SolutionDir)GameInstall\Kingmaker_Data\Managed\*.dll" />
      <_GameDllsUMM Include="$(SolutionDir)GameInstall\Kingmaker_Data\Managed\UnityModManager\*.dll" />
      <_PublicizedDlls Include="$(SolutionDir)KingmakerTactics\obj\$(Configuration)\publicized\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_GameDllsBase)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_GameDllsUMM)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PublicizedDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" />
  </Target>

</Project>
